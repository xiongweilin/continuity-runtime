FROM python:3.12-slim@sha256:aa943ce411423c7582288f18707ff66eddcbaeb510502d747a72aeb34f30d159
WORKDIR /app
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_DISABLE_PIP_VERSION_CHECK=1 PYTHONPATH=/app
COPY pyproject.toml README.md ./
COPY Dockerfile.phase-c compose.phase-c.yaml ./
COPY src ./src
COPY migrations ./migrations
COPY alembic.ini ./
COPY tests ./tests
COPY docs/phase-c-experiment-protocol.md ./docs/phase-c-experiment-protocol.md
COPY scripts ./scripts
COPY experiments ./experiments
RUN python -m pip install --no-cache-dir -r experiments/phase_c/requirements.lock \
    && python -m pip install --no-cache-dir --no-build-isolation --no-deps .
# Root is the experiment controller only. It starts provider, fault-proxy and
# arm child processes under distinct unprivileged UIDs; the compose network is
# internal and has no published ports.
CMD ["python", "-c", "import time; time.sleep(10000000)"]
