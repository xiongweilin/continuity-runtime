FROM python:3.12-slim@sha256:aa943ce411423c7582288f18707ff66eddcbaeb510502d747a72aeb34f30d159
WORKDIR /app
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_DISABLE_PIP_VERSION_CHECK=1 PYTHONPATH=/app
COPY experiments/phase_c/requirements.lock /tmp/phase-d-requirements.lock
RUN python -m pip install --no-cache-dir -r /tmp/phase-d-requirements.lock
COPY pyproject.toml README.md ./
COPY Dockerfile.phase-d compose.phase-d.yaml ./
COPY src ./src
COPY migrations ./migrations
COPY alembic.ini ./
COPY examples ./examples
COPY tests ./tests
COPY docs/phase-c-experiment-protocol.md ./docs/phase-c-experiment-protocol.md
COPY docs/phase-d-protocol.md ./docs/phase-d-protocol.md
COPY docs/phase-d-codex-handoff.md ./docs/phase-d-codex-handoff.md
COPY scripts ./scripts
COPY experiments ./experiments
RUN python -m pip install --no-cache-dir --no-build-isolation --no-deps .
# The root process is only an isolated test controller. It creates all effect,
# authority, source, domain-owner, and arm processes as distinct unprivileged UIDs.
CMD ["python", "-c", "import time; time.sleep(10000000)"]
